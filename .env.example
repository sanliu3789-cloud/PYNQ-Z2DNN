# 复制为 .env 后填入真实值；.env 已在 .gitignore 中，不会被提交。
# 这些变量由 host/ 下的脚本读取，代码中没有任何默认口令或板卡地址。

# --- 板卡网络 ---
PYNQ_HOST=192.0.2.10
PYNQ_USER=xilinx
PYNQ_PASSWORD=

# 板卡 SSH 主机密钥指纹（首次连接时核对，防止中间人）
# 获取方式：ssh-keyscan -t ed25519 <PYNQ_HOST> 或第一次交互式 plink 连接时记录
PYNQ_HOSTKEY=SHA256:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Windows 下 plink.exe 的完整路径；Linux/macOS 用 plink 或留空
PYNQ_PLINK=plink

# 板端 Python 解释器（PYNQ 3.x 默认）
PYNQ_PYTHON=/usr/local/share/pynq-venv/bin/python3

# --- 本机/板端 API 地址 ---
# 本机预览默认 http://127.0.0.1:8765
NIHSS_PREVIEW_URL=http://127.0.0.1:8765
# 板端网页默认 http://127.0.0.1:8080
PYNQ_URL=http://127.0.0.1:8080
# 触屏终端访问的 API（留空则为 http://127.0.0.1:8080）
NIHSS_API_BASE=
# 需要额外放行的 API 地址（逗号分隔），例如 http://192.0.2.10:8080
NIHSS_API_ALLOW=

# --- 浏览器自动化 ---
CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe

# --- 局域网诊断（power_diagnosis_20261101/find_board_arp.py）---
NIHSS_LAN_CIDR=192.168.1.0/24
NIHSS_BOARD_MAC=
NIHSS_LAN_SKIP=
